DATASET_ID=                # Dataset/Pixel ID من Events Manager

# ===== الإعلانات (Marketing API) =====
ADS_TOKEN=                 # System User Token بصلاحية ads_management
AD_ACCOUNT_ID=             # act_XXXXXXXXX
PAGE_ID=                   # صفحة الفيسبوك
CATALOG_ID=                # الكتالوج الواحد
LOOKALIKE_AUDIENCE_ID=     # جمهور الـ Lookalike 1% (الدولة: إسرائيل) — يُنشأ مرة من مدير الإعلانات

# ===== إعدادات الماكينة =====
